# Public Supabase credentials for client and server
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
# Used exclusively for privileged operations like creating a new lodge tenant during registration
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub Releases URL for Tauri desktop installers
NEXT_PUBLIC_TAURI_RELEASES_URL=https://github.com/your-org/lodge-saas/releases/latest
